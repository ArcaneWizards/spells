{
  "name": "@arcanewizards/spell",
  "description": "Open-source file-format for musical timing data for use in live events",
  "version": "2.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArcaneWizards/spells.git",
    "directory": "packages/spell"
  },
  "exports": {
    ".": {
      "@arcanewizards/spell-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && check-export-map",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:private": "pnpm lint",
    "lint:fix": "eslint --fix .",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage"
  },
  "devDependencies": {
    "@arcanewizards/spell-eslint-config": "workspace:^",
    "@arcanewizards/spell-typescript-config": "workspace:^",
    "@jest/globals": "^30.1.2",
    "check-export-map": "^1.3.1",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
