{
  "name": "@arcanewizards/spell",
  "version": "2.0.0",
  "private": false,
  "exports": {
    ".": {
      "@arcanewizards/spell-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && check-export-map",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:private": "pnpm lint",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@arcanewizards/spell-eslint-config": "workspace:^",
    "@arcanewizards/spell-typescript-config": "workspace:^",
    "check-export-map": "^1.3.1",
    "eslint": "^9.39.4",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  }
}
